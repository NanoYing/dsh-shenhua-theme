{
  "name": "dsh-theme-shenhua",
  "version": "0.1.1",
  "description": "上海申花 · 蓝血主场主题，为 DeepSeek Harness 提供浅色、深色与品牌界面。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "preview",
    "screenshots",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES",
    "LICENSING.md",
    "CONTRIBUTING.md",
    "src",
    "build",
    "tests",
    "tsconfig.json",
    "tsdown.config.ts",
    "pnpm-lock.yaml"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "precheck": "pnpm build",
    "check": "tsc --noEmit && node --test tests/*.test.mjs",
    "pack:local": "pnpm pack --pack-destination dist",
    "release:check": "pnpm check && npm pack --dry-run"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "shanghai-shenhua",
    "上海申花"
  ],
  "license": "SEE LICENSE IN LICENSING.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoYing/dsh-shenhua-theme.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.15.1"
}
